{
  "manifest_version": 3,
  "name": "FormStatus",
  "version": "1.0.0",
  "description": "Monitor and check your web forms status directly from your browser",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://dev-app.formstatus.co/*",
    "https://stg-app.formstatus.co/*",
    "https://app.formstatus.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://app.formstatus.co/*",
      "https://stg-app.formstatus.co/*",
      "https://dev-app.formstatus.co/*",
      "http://localhost:8080/*"
    ]
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/fs-icon.png",
      "32": "icons/fs-icon.png",
      "48": "icons/fs-icon.png",
      "128": "icons/fs-icon.png"
    }
  },
  "icons": {
    "16": "icons/fs-icon.png",
    "32": "icons/fs-icon.png",
    "48": "icons/fs-icon.png",
    "128": "icons/fs-icon.png"
  },
  "key": ""
}
